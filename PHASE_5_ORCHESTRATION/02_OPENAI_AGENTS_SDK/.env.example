# Copy to .env (in this folder). Everything runs on local Ollama by default.

# Which provider notebooks use by default: ollama | openai
MODEL_PROVIDER=ollama

# Ollama (local, free). Must support tool calling.
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_BASE_URL=http://localhost:11434

# Optional: OpenAI. With a key set, traces are also uploaded to the OpenAI
# dashboard (platform.openai.com/traces); without one, tracing export is off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
