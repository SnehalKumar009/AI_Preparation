# Copy to .env (in this folder). Everything runs on local Ollama by default.

# Which provider notebooks use by default: ollama | openai
MODEL_PROVIDER=ollama

# Ollama (local, free). Must support tool calling.
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_BASE_URL=http://localhost:11434
# Embedding model for crew memory (notebook 09)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# CrewAI sends anonymous usage telemetry by default; this section turns it off.
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
