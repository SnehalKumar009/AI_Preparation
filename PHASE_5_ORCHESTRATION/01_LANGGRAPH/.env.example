# Copy to .env (in this folder) and fill in what you have. Everything runs on
# local Ollama by default; cloud keys are optional.

# Which provider notebooks use by default: ollama | openai | anthropic
MODEL_PROVIDER=ollama

# Ollama (local, free). The model must support tool calling.
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: LangSmith tracing (notebook 09)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=phase5-langgraph
